# One-container public demo for free hosts such as Render: the hospital web app
# and API at /, and the vendor fleet console at /fleet, linked only by the signed
# patient-free heartbeat.
# Contains the frozen model and 24 de-identified PhysioNet 2019 replay records
# (open access, CC BY 4.0). Never build this image with hospital data.
#
#   docker build --platform linux/amd64 -f infra/Dockerfile.demo -t <dockerhub-user>/predictrx-demo:latest .
#   docker run -p 10000:10000 <dockerhub-user>/predictrx-demo:latest     # http://localhost:10000

FROM --platform=linux/amd64 node:20-bookworm-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ENV API_PROXY_TARGET=http://127.0.0.1:8000 \
    FLEET_PROXY_TARGET=http://127.0.0.1:8100 \
    NEXT_PUBLIC_FLEET_URL=/fleet \
    NEXT_PUBLIC_JUDGE_DEMO=true \
    NEXT_PUBLIC_REPLAY_AUTO_SECONDS=20 \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM --platform=linux/amd64 python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --from=web /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY ml /app/ml
WORKDIR /app/backend
COPY backend/requirements.txt ./
# Upgrade the base image's pip first: pip-audit flagged pip 25.0.1 itself
# (docs/evidence/vulnerability-disposition.md). pip is build tooling, but the
# shipped installer should not carry known advisories.
# Install the local ML package explicitly: backend/requirements.txt no longer
# carries `-e ../ml` (that path breaks GitHub Actions install from repo root).
RUN pip install --no-cache-dir --upgrade "pip>=26.2" \
    && pip install --no-cache-dir /app/ml \
    && pip install --no-cache-dir -r requirements.txt
COPY backend /app/backend
COPY knowledge /app/knowledge
COPY demo/cases /app/demo/cases
COPY control-plane /app/control-plane

COPY --from=web /web/.next/standalone /app/web
COPY --from=web /web/.next/static /app/web/.next/static
COPY --from=web /web/public /app/web/public
COPY infra/demo-start.sh /app/demo-start.sh

# python:slim has bash; strip any CRLF so Render's exec does not look for /bin/bash\r
# ("no such file or directory" with the script present = classic Windows line endings).
RUN useradd --system --uid 10001 --home-dir /app predictrx \
    && sed -i 's/\r$//' /app/demo-start.sh \
    && chmod +x /app/demo-start.sh \
    && head -1 /app/demo-start.sh | grep -q '^#!/bin/bash$'
USER predictrx

ENV DEMO_MODE=true \
    SITE_ID=predictrx-public-demo \
    DATABASE_URL=sqlite:////tmp/predictrx.db \
    MODEL_PATH=/app/ml/artifacts/models/latest/model.joblib \
    METRICS_DIR=/app/ml/artifacts/models/latest \
    DEMO_CASES_DIR=/app/demo/cases \
    PUBLIC_DEMO_LOCKDOWN=true \
    PUBLIC_SIMULATION_ENABLED=true \
    PUBLIC_SIMULATION_INTERVAL_SECONDS=30 \
    DEMO_REPLAY_AUTO_INTERVAL_SECONDS=20 \
    WRITER_LEASE_ENABLED=false \
    DOCS_OPENAPI_URL=/api/openapi.json \
    CORS_ORIGINS=[] \
    PORT=10000 \
    NEXT_TELEMETRY_DISABLED=1 \
    OMP_NUM_THREADS=1 \
    PYTHONUNBUFFERED=1

EXPOSE 10000
CMD ["/app/demo-start.sh"]
