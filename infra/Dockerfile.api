FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY ml /app/ml
COPY backend /app/backend
COPY knowledge /app/knowledge
WORKDIR /app/backend
# Install the local ML package explicitly: backend/requirements.txt no longer
# carries `-e ../ml` (that path breaks GitHub Actions install from repo root).
RUN pip install --no-cache-dir /app/ml && pip install --no-cache-dir -r requirements.txt

# Replay cases are mounted at runtime (demo mode only); they are never baked into the image.
RUN useradd --system --uid 10001 --home-dir /app predictrx \
    && mkdir -p /app/backups /app/demo/cases \
    && chown -R predictrx /app/backups /app/backend
USER predictrx

ENV MODEL_PATH=/app/ml/artifacts/models/latest/model.joblib \
    METRICS_DIR=/app/ml/artifacts/models/latest \
    DEMO_CASES_DIR=/app/demo/cases \
    PYTHONUNBUFFERED=1

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"
# One worker per site: the engine holds the single-writer lease, so extra workers would start read-only.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers"]
