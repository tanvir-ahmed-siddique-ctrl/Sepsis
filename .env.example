# --- Local demo (default) -------------------------------------------------------------
DEMO_MODE=true
MODEL_PATH=../ml/artifacts/models/run4_frozen/model.joblib
METRICS_DIR=../ml/artifacts/models/run4_frozen
DATABASE_URL=sqlite:///backend/predictrx.db
JWT_SECRET=change-me-before-non-demo-use-32-bytes
# Separate 32+ character key used to encrypt local-account TOTP secrets at rest.
ACCOUNT_ENCRYPTION_KEY=change-me-separately-for-local-account-secrets
POSTGRES_PASSWORD=change-me-for-shared-environments
# Used by the Next server for hospital-local API forwarding; never exposed in browser bundles.
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional separate organization account authority. Keep its database and secrets outside
# the hospital clinical service; never point this at a patient-data API.
ACCOUNT_API_INTERNAL_URL=
# Evaluation bridge only. Set in an isolated synthetic deployment with dedicated secrets.
EVALUATION_RUNTIME=false
EVALUATION_HOSPITAL_PASSWORD=
EVALUATION_ACCOUNT_PASSWORD=
# Vendor account authority: set both on a commissioned deployment. Generate the
# Fernet key outside source control, then enrol vendor TOTP before enabling access.
ACCOUNT_REQUIRE_MFA=false
ACCOUNT_MFA_KEY=
# Private commercial PDF vault. Generate an independent Fernet key and configure
# an approved ClamAV-compatible scanner before production document uploads.
ACCOUNT_DOCUMENT_KEY=
ACCOUNT_CLAMD_HOST=
ACCOUNT_CLAMD_PORT=3310
ACCOUNT_LICENCE_KEY_ID=
ACCOUNT_LICENCE_PRIVATE_KEY=
# Hospital-local: public verification keys only. Private signing key never goes to site.
LICENCE_REQUIRED=false
LICENCE_PUBLIC_KEYS_JSON={}

# --- Site operation -------------------------------------------------------------------
# SITE_MODE is only the mode requested at first start (demo | silent | live-disabled | live).
# Afterwards the persisted, audited site configuration wins; change it from the Pilot page.
SITE_ID=predictrx-local-site
SITE_MODE=demo
ALERT_REVIEW_SLA_MINUTES=15
FEED_STALE_MINUTES=120
WRITER_LEASE_SECONDS=300
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Silent-pilot gates that must pass before the site can leave silent mode.
PILOT_MIN_DAYS=28
PILOT_MIN_ENCOUNTERS=100
PILOT_MIN_ADJUDICATED=30
PILOT_MIN_SENSITIVITY=0.5
PILOT_MAX_ALERTS_PER_100H=2.0

# --- Authentication -------------------------------------------------------------------
# local: HS256 tokens issued by this API. oidc: hospital IdP tokens validated via JWKS.
AUTH_MODE=local
# Old secrets stay valid for verification only while tokens issued with them expire.
JWT_PREVIOUS_SECRETS=[]
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_USER_CLAIM=preferred_username
OIDC_ROLE_CLAIM=roles
OIDC_UNITS_CLAIM=icu_units
OIDC_ROLE_MAP={"predictrx-clinician":"clinician","predictrx-admin":"admin","predictrx-integration":"integration"}

# Connector credentials: only SHA-256 hashes live here. Generate with
#   python -m app.ops_cli new-integration-key --key-id lab-feed --units icu-a --scopes ingest:hl7v2
INTEGRATION_API_KEYS=[]

# --- Data governance and monitoring ---------------------------------------------------
RETENTION_DAYS=365
EXPORT_SALT=change-me-before-exporting-pilot-data
# Bearer token Prometheus uses to scrape /metrics without a user session.
METRICS_TOKEN=

# Abuse limits per client per minute; bodies above MAX_REQUEST_BYTES get 413.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_INGEST_PER_MINUTE=1200
MAX_REQUEST_BYTES=12582912
# Reverse-proxy address trusted for X-Forwarded-For (uvicorn). Site/public-demo stacks set it.
FORWARDED_ALLOW_IPS=127.0.0.1

# Mapping copilot model. Blank URL keeps the copilot deterministic. Only field names and
# units are sent, never patient values.
#   ollama (default, on-premises): COPILOT_LLM_URL=http://host.docker.internal:11434
#   openai (any OpenAI-compatible API), COPILOT_LLM_URL examples:
#     Gemini      https://generativelanguage.googleapis.com/v1beta/openai   model gemini-2.5-flash
#     Groq        https://api.groq.com/openai/v1                            model qwen/qwen3-32b
#     OpenRouter  https://openrouter.ai/api/v1
#     OpenAI      https://api.openai.com/v1
# Outside DEMO_MODE an endpoint beyond the hospital network is refused unless
# COPILOT_EXTERNAL_LLM_APPROVED=true (the hospital's decision).
COPILOT_LLM_PROVIDER=ollama
COPILOT_LLM_URL=
COPILOT_LLM_MODEL=qwen3.5:4b
COPILOT_LLM_API_KEY=
COPILOT_EXTERNAL_LLM_APPROVED=false
# Site-wide cap on model calls per minute; extra requests fall back to deterministic.
COPILOT_LLM_PER_MINUTE=30
# Optional embedding model for hybrid (keyword + vector) retrieval, e.g. qwen3-embedding:0.6b
COPILOT_EMBED_MODEL=

# Fleet heartbeat signing key shared with the vendor control plane (control-plane/).
FLEET_SIGNING_KEY=

# --- docker-compose.site.yml only -----------------------------------------------------
# The web container reaches the API at http://api:8000 on its private Compose network.
